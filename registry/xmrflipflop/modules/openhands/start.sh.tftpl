#!/usr/bin/env bash

set -o errexit
set -euo pipefail

# Convert terraform templated variables to shell variables
readonly INSTALL_DIR=${_install_dir}
readonly CHECKOUT_URL=${_checkout_url}
readonly CHECKOUT_BRANCH=${_checkout_branch}
readonly PORT=${_ingress_port}
readonly PRE_INSTALL_SCRIPT=${_pre_install_script}

# shellcheck disable=SC2034
readonly BOLD='\033[0;1m'
readonly RESET='\033[0m'

# PRE_INSTALL
MODULE_DIR="/tmp/.coder-modules/openhands"
mkdir -p "$MODULE_DIR/scripts" "$MODULE_DIR/logs"

if [ -n "$PRE_INSTALL_SCRIPT" ]; then
  echo -e "$${BOLD}Running pre_install_script..."
  echo "$PRE_INSTALL_SCRIPT" | base64 -d > "$MODULE_DIR/scripts/pre_install.sh"
  chmod +x "$MODULE_DIR/scripts/pre_install.sh"
  if ! "$MODULE_DIR/scripts/pre_install.sh" 2>&1 | tee "$MODULE_DIR/logs/pre_install.log"; then
    echo -e "$${BOLD}ERROR: pre_install_script failed, see $MODULE_DIR/logs/pre_install.log" >&2
    exit 1
  fi
fi

# Actual launch script
set -o errexit
set -euo pipefail

# Ensure a command/package is installed; install it if missing.
#
# Usage:
#   ensure_installed <command> [install_command] [check_command]
#
# Defaults: install via `sudo apt install -y <command>`,
# check via `command -v <command>`. Both strings are run with eval.
#
# Examples:
#   ensure_installed stow
#   ensure_installed uv 'curl -LsSf https://astral.sh/uv/install.sh | sh'
#   ensure_installed bash-completion '' 'dpkg -s bash-completion'
ensure_installed() {
    local cmd="$1"
    local installer="${2:-sudo apt-get install -y $1}"
    local checker="${3:-command -v $1}"
    if eval "$checker" >/dev/null 2>&1; then
        echo "$cmd is already installed."
        return 0
    fi
    echo "Installing $cmd..."
    eval "$installer"
}


echo -e "$${BOLD}Checking Dependencies ...\n\n"

# Reload env vars like PATH if they've been freshly installed
# hopefully captured here in .bash_profile
if [ -f "$HOME/.bash_profile" ]; then
    source "$HOME/.bash_profile"
fi

ensure_installed git

ensure_installed uv 'curl -LsSf https://astral.sh/uv/install.sh | sh'
if ! command -v just &> /dev/null; then
    # source to add new `uv` to PATH
    source "$HOME/.local/bin/env"
fi

# uv provides latest version over apt
ensure_installed just 'uv tool install rust-just'

ensure_installed nvm 'curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.6/install.sh | bash'
if ! command -v just &> /dev/null; then
    # source to add new `nvm` to PATH
    source "$HOME/.nvm/nvm.sh"
fi
ensure_installed node 'nvm install --lts'

ensure_installed pm2 'npm install pm2 -g'

echo -e "$${BOLD}Installing OpenHands ...\n\n"

# Clone repository if it doesn't exist
if [ ! -d "$${INSTALL_DIR}/.git" ]; then
    sudo rm -rf $${INSTALL_DIR}
    sudo install -d -m 0755 -o "$(id -un)" -g "$(id -gn)" "$${INSTALL_DIR}"
    echo "Cloning $${CHECKOUT_URL}..."
    git clone --no-checkout "$${CHECKOUT_URL}" "$${INSTALL_DIR}"
fi

cd "$${INSTALL_DIR}"

git fetch --depth 1 origin "$${CHECKOUT_BRANCH}"
git checkout -f -B "$${CHECKOUT_BRANCH}" FETCH_HEAD
git clean -fdx
just setup --production

echo -e "🥳 $${BOLD}Installation complete!\n\n"

echo -e "👷 $${BOLD}[Re]starting OpenHands in background...\n\n"

just serve --production --background --stop || true
just serve --production --background --ingress_port "$PORT" --fe_port "$((PORT + 1))" --be_port "$((PORT + 2))"

echo -e "📝 $${BOLD}Check logs with\n$${RESET}\t pm2 logs prod-1"
